# jetop-service 配置文件模板
# 请复制此文件并重命名为 .env，然后按需填写本地身份验证令牌

# ===========================================================
# ⚠️ 重要：VITE_AUTH_TOKEN 是 Jetop 后端 X-JetopDebug-User 调试后门
#   - 仅在本地开发（npm run dev）生效
#   - 生产构建（npm run build / CI 打包）会被自动忽略
#   - 绝不要在 CI/CD 中为生产环境注入此变量，否则会绕开 SSO 登录
# ===========================================================
# 复制方法：浏览器访问 https://test1.tepc.cn/jetopcms/ks/protalpage_layui.aspx?id=137c1dbc-58b3-ddb0-0340-a029a324457d
#           登录后从任意接口的请求头中复制 X-JetopDebug-User 的值
VITE_AUTH_TOKEN=

# 仅本地前端调试使用：跳过启动登录校验，并使用 LocalStorage 保存文件、偏好和预设视图。
# 需要真实联调 Jetop 后端时请改回 false，并填写上面的 VITE_AUTH_TOKEN。
VITE_SKIP_AUTH=false

# API 配置（必需）
VITE_API_BASE_URL=https://test1.tepc.cn/jetopcms

# 可选配置
VITE_REQUEST_TIMEOUT=30000
VITE_DEBUG=true
